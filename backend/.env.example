# Server Configuration
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development

# Database Path (Optional: defaults to local ./data/elderly_care.db)
# On Render.com with a Persistent Disk mount (e.g. at /var/data), set:
# DB_PATH=/var/data/elderly_care.db
DB_PATH=

# Email Notifications (Nodemailer Gmail App Password)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# If left blank, notifications will log to console in mock/safe mode without error.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# AI Wellbeing Check-in (Optional Gemini API key)
# If left blank, the built-in clinical fuzzy NLP engine handles risk analysis and symptom extraction.
GEMINI_API_KEY=
